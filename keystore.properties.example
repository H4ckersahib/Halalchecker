# Copy to keystore.properties (same folder, not committed) and fill in your values.
# Release builds (./gradlew assembleRelease) are then signed with this key.
# Never lose the .jks file or its password: without them installed apps can't be updated.
storeFile=C:/Users/Younes/keys/halalcheck-release.jks
storePassword=YOUR_PASSWORD
keyAlias=halalcheck
keyPassword=YOUR_PASSWORD
